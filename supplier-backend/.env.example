# ─────────────────────────────────────────────────────────────────────────────
# Supplier Backend — Environment Configuration
# Copy this file to `.env` and fill in the values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Application mode: `development` or `production`.
# In production, JWT_SECRET is REQUIRED and error stacks are hidden from clients.
NODE_ENV=development

# Port the HTTP server listens on. (default: 3001)
PORT=3001

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supplier_product_db?schema=public"

# ─── Authentication ──────────────────────────────────────────────────────────
# Secret used to sign and verify JWT tokens.
# REQUIRED in production — the server will refuse to start if it is missing.
# Generate a strong value, e.g.: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# JWT token lifetime. (default: 7d) Examples: 1h, 12h, 7d, 30d
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Takes precedence over CLIENT_URL when both are set.
# In development, defaults to http://localhost:5173 and http://localhost:3000.
# In production, only the origins listed here are allowed (no wildcard).
ALLOWED_ORIGINS="http://localhost:5173,https://your-domain.vercel.app"

# Single client URL (comma-separated values also accepted).
# Used as a fallback when ALLOWED_ORIGINS is not set.
CLIENT_URL="http://localhost:5173"

# ─── Automated Sync (Cron) ───────────────────────────────────────────────────
# Cron expression for the automated supplier feed sync job.
# (default: 0 */6 * * *  → every 6 hours at minute 0)
SYNC_CRON_SCHEDULE="0 */6 * * *"

# Set to `true` to disable the automated sync cron job entirely. (optional)
DISABLE_CRON=false
