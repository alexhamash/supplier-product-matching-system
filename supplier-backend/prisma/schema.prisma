// ─── Generator ──────────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

// ─── Datasource ─────────────────────────────────────────────────────────────
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────
enum MatchStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The type of price feed a supplier provides.
enum FeedType {
  CSV
  GOOGLE_SHEETS
}

// ─── Models ─────────────────────────────────────────────────────────────────

/// Represents an authenticated user of the system.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String

  createdAt DateTime @default(now())

  @@map("users")
}

/// Represents a supplier entity that provides product data.
model Supplier {
  id          String   @id @default(uuid())
  name        String   @unique
  contactInfo String?

  // ─── Feed / Ingestion Settings ────────────────────────────────────────────
  /// URL to the Google Sheet or CSV price feed.
  feedUrl String?
  /// Feed type — either a raw CSV file or a Google Sheet.
  feedType FeedType @default(CSV)
  /// Toggle for automated periodic (cron) ingestion.
  autoSync Boolean @default(false)
  /// Timestamp of the last successful import.
  lastSyncedAt DateTime?

  supplierProducts SupplierProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

/// Represents the canonical (master) product record in the system.
model MainProduct {
  id    String  @id @default(uuid())
  sku   String  @unique
  name  String
  description String?
  price Float

  productMatches ProductMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("main_products")
}

/// Represents a product as provided by a specific supplier.
model SupplierProduct {
  id         String   @id @default(uuid())
  supplierId String
  rawSku     String
  rawName    String
  price      Float
  /// Whether the product is currently available in the supplier's feed.
  inStock    Boolean  @default(true)

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  matches   ProductMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, rawSku])
  @@map("supplier_products")
}

/// Represents a match (suggestion) linking a supplier product to a main product.
model ProductMatch {
  id              String      @id @default(uuid())
  mainProductId   String
  supplierProductId String
  status          MatchStatus @default(PENDING)
  confidenceScore Float?

  mainProduct     MainProduct     @relation(fields: [mainProductId], references: [id])
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mainProductId, supplierProductId])
  @@map("product_matches")
}
